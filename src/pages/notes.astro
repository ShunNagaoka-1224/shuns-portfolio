---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allNotes = (await getCollection('notes')).sort(
  (a: any, b: any) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout title="Notes | Shun Nagaoka">
  <div class="notes-header">
    <h1>Notes</h1>
    <p class="description">研究・モノづくり・日々の思考や読書の記録ログ</p>
  </div>

  <div class="notes-grid">
    {allNotes.map((note: any) => (
      <article class="note-card">
        <a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/notes/${note.id}`}>
          <div class="card-meta">
            <span class="category-badge">{note.data.category}</span>
            <time datetime={note.data.pubDate.toISOString()}>
              {note.data.pubDate.toLocaleDateString('ja-JP')}
            </time>
          </div>
          <h2 class="card-title">{note.data.title}</h2>
          {note.data.summary && <p class="card-summary">{note.data.summary}</p>}
          <div class="card-tags">
            {note.data.tags.map((tag: string) => (
              <span class="tag">#{tag}</span>
            ))}
          </div>
        </a>
      </article>
    ))}
  </div>
</Layout>

<style>
  .notes-header {
    margin-bottom: 2.5rem;
  }
  .notes-header h1 {
    font-size: 2rem;
    font-weight: 700;
    color: #1d1d1f;
    margin-bottom: 0.5rem;
  }
  .description {
    color: #666;
    font-size: 0.95rem;
  }
  .notes-grid {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .note-card a {
    display: block;
    padding: 1.5rem;
    background: #ffffff;
    border: 1px solid #e5e5e5;
    border-radius: 12px;
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .note-card a:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
    border-color: #d1d1d6;
  }
  .card-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.85rem;
    color: #86868b;
    margin-bottom: 0.5rem;
  }
  .category-badge {
    background: #e8f2ff;
    color: #0066cc;
    padding: 0.2rem 0.6rem;
    border-radius: 6px;
    font-weight: 600;
    font-size: 0.75rem;
  }
  .card-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: #1d1d1f;
    margin: 0.25rem 0 0.5rem 0;
  }
  .card-summary {
    font-size: 0.9rem;
    color: #515154;
    line-height: 1.5;
    margin-bottom: 0.75rem;
  }
  .card-tags {
    display: flex;
    gap: 0.5rem;
  }
  .tag {
    font-size: 0.8rem;
    color: #86868b;
  }
</style>